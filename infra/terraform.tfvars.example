# Copy to a local file (do not commit secrets). Prefer TF_VAR_* environment variables.
subscription_id = "00000000-0000-0000-0000-000000000000"
prefix          = "comuni-itn-001"
location        = "italynorth"
image                    = "replace.azurecr.io/comuni:immutable-sha"
authentication_authority = "https://replace-with-real-issuer.example/"
authentication_audience  = "Comuni.Api"
tags = {
  project     = "Comuni"
  managed_by  = "Terraform"
  environment = "development"
}
# postgres_admin_password and postgres_runtime_password must be supplied separately as secrets. OIDC authority is not a secret.

# Tenant HMAC signing material is NEVER a Terraform variable. Provision the
# tenant-proof-key Key Vault secret through an approved external operation.
# tenant_proof_key_id is now REQUIRED (never empty or legacy) after
# staging its matching non-legacy key in PostgreSQL as schema owner.
# tenant_proof_key_id = "rotate_2026_11"  # ID only, not the HMAC secret

# Set tenant_proof_secret_version to the exact 32-hex Key Vault version
# (approved deployment metadata). It is not the signing key value.
# In GitHub production Environment use TENANT_PROOF_SECRET_VERSION.

# Staged ACA rollout requires an *existing* production revision and a pinned
# stable Key Vault version. Configure GitHub Environment variables:
# STABLE_REVISION_SUFFIX and STABLE_TENANT_PROOF_SECRET_VERSION.
# Candidate is staged at 0% traffic; no automatic traffic promotion.
# First-ever environment bootstrap needs a separate approved process (#6).

# Optional browser OIDC login (all four public settings together):
# authentication_browser_client_id = "<SPA public client ID>"
# authentication_browser_authorization_endpoint = "https://trusted-idp/.../authorize"
# authentication_browser_token_endpoint = "https://trusted-idp/.../token"
# authentication_browser_scope = "openid profile api://.../access_as_user"
# Values must match Authentication.Authority's HTTPS hostname.
# Configure GitHub Environment OIDC_BROWSER_* vars; no browser client secret.
# Until a provider is registered, the UI DISABLES Production login.


# Platform Superadmin inventory (#38, ADR 0032): OFF by default.
# A second SQL role must be owner-provisioned on the SAME PostgreSQL instance
# in the private VNet. Its full connection string (with restricted username)
# is created EXTERNALLY as Key Vault secret 'platform-inventory-connection'.
# Terraform NEVER receives its password or connection string, only optional
# approved version metadata:
# platform_inventory_enabled        = false
# platform_inventory_secret_version = ""
#
# The GitHub Actions manual Deploy workflow has input:
#   enable_platform_inventory = false (default)
# and reads GitHub Environment variable PLATFORM_INVENTORY_SECRET_VERSION
# (exact 32-hex Key Vault version, no value). Opt in ONLY after approval,
# owner-side SQL role verification, OIDC/MFA and two-tenant synthetic smoke
# readiness. It stages at 0% traffic; stable retains 100%.
# NEVER put the connection string/role password in tfvars or TF_VAR_*.
# Future rotations must retain all app-scoped stable secrets until retired
# under a separate approved plan; the stage gate blocks removal.

# Candidate runtime PostgreSQL secret (#50, ADR 0043): REQUIRED metadata only.
# Runtime login connection string MUST be externally provisioned in Key Vault
# as 'postgres-runtime-connection' at an approved exact 32-hex version.
# It must use the real Azure PostgreSQL FQDN, 'comuni_app_runtime', and
# 'SSL Mode=VerifyFull;Trust Server Certificate=false'. Never place password,
# connection string, TLS certificates or other secret bytes in tfvars/state.
# runtime_postgres_connection_secret_version = "dddddddddddddddddddddddddddddddd"  # synthetic example
# In the protected GitHub environment use RUNTIME_POSTGRES_CONNECTION_SECRET_VERSION.
# Existing 'postgres-connection' is versionless and STILL holds a runtime password
# in historical/current Terraform state; do not rotate or overwrite it in place.
