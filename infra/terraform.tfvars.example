# Copy to a local file (do not commit secrets). Prefer TF_VAR_* environment variables.
subscription_id = "00000000-0000-0000-0000-000000000000"
prefix          = "comuni-itn-001"
location        = "italynorth"
image                    = "replace.azurecr.io/comuni:immutable-sha"
authentication_authority = "https://replace-with-real-issuer.example/"
authentication_audience  = "Comuni.Api"
tags = {
  project     = "Comuni"
  managed_by  = "Terraform"
  environment = "development"
}
# postgres_admin_password and postgres_runtime_password must be supplied separately as secrets. OIDC authority is not a secret.

# Tenant HMAC signing material is NEVER a Terraform variable. Provision the
# tenant-proof-key Key Vault secret through an approved external operation.
# Set tenant_proof_key_id only after staging the matching key in PostgreSQL.
